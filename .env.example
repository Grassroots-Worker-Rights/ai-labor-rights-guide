# Copy to .env and fill in. Never commit .env.

# DeepSeek LLM API key (required for the chat endpoint).
DEEPSEEK_API_KEY=

# Meilisearch master key — server-side trusted key used by the backend for ingest + search.
# Generate a strong random value, e.g. `openssl rand -base64 32`.
MEILI_MASTER_KEY=

# Allowed CORS origins for the Angular dev server (comma-separated). Leave empty in production
# (nginx serves frontend + API same-origin). Dev default is http://localhost:4200.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Chat RAG backend for the LLM (the /api/search box always uses Meilisearch regardless):
#   meili (default) = Meilisearch hybrid;  chroma = ChromaDB vector.
# chroma needs the chromadb container, which is off by default: uncomment COMPOSE_PROFILES below,
# redeploy, then re-run /api/admin/ingest before switching.
APP_RAG_PROVIDER=meili
# COMPOSE_PROFILES=chroma
# ChromaDB connection (compose defaults to the chromadb service). Override for an external Chroma.
# CHROMA_HOST=http://chromadb
# CHROMA_PORT=8000

# Production only (docker-compose.prod.yml + init-ssl.sh):
DOMAIN=
EMAIL=

# Stage subdomain, served by the PROD nginx with the same certificate (prod .env only; required).
STAGE_DOMAIN=

# Per-IP rate limiting on /api/chat and /api/search (default true).
APP_RATELIMIT_ENABLED=true
